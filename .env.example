# 11Care Nursing Platform - Environment Variables
# Copy this file to .env and fill in the values

# ============================================
# MANDATORY VARIABLES (Application will not start without these)
# ============================================

# Encryption key for patient data (AES-256-GCM)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Default passwords for initial user setup
# IMPORTANT: Change these immediately after first login
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ENFERMEIRO_PASSWORD=

# JWT Secret for token signing
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_SECRET=

# ============================================
# OPTIONAL VARIABLES
# ============================================

# Setup key for initial admin creation (one-time use)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SETUP_KEY=

# N8N Webhook secret for patient data sync
N8N_WEBHOOK_SECRET=

# AI API Keys (for clinical analysis)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Database URL (auto-configured on Replit)
DATABASE_URL=

# Environment
NODE_ENV=development

# ============================================
# SECURITY NOTES
# ============================================
# 1. NEVER commit .env file to version control
# 2. Use strong, unique passwords (min 12 characters)
# 3. Rotate ENCRYPTION_KEY only with proper data migration
# 4. JWT_SECRET rotation will invalidate all active sessions
